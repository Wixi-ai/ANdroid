<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/black_soft"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_short_name"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="WL"
                android:textColor="@color/red_main"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/circle_bg" />

            <TextView
                android:id="@+id/tv_full_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Winline"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Описание"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/bonus_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2A2A2A"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎁"
                android:textSize="20sp"
                android:textColor="@color/red_main" />

            <TextView
                android:id="@+id/tv_bonus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Бонус"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_advantages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Преимущество 1\n• Преимущество 2"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_go"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Перейти"
            android:textColor="@color/white"
            app:backgroundTint="@color/red_main"
            app:cornerRadius="24dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>